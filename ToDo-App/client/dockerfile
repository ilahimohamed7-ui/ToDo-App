
# 1. Build-Stage (React/Vite builden)

FROM node:20-alpine AS build

WORKDIR /app

# package.json + lockfile kopieren
COPY package*.json ./

# Dependencies installieren
RUN npm install

# Restlichen Code kopieren
COPY . .

# Production-Build erstellen
RUN npm run build

# -------------------------
# 2. Run-Stage (Nginx dient das fertige Frontend aus)
# -------------------------
FROM nginx:alpine

# Unsere eigene Nginx-Config für React-Routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Den Build-Output aus Stage 1 in den HTML-Ordner von Nginx kopieren
COPY --from=build /app/dist /usr/share/nginx/html

# Nginx-Port
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
