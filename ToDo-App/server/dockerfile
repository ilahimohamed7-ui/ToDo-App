

FROM node:20-alpine


FROM node:20-alpine


RUN apk add --no-cache tzdata \
  && cp /usr/share/zoneinfo/Europe/Berlin /etc/localtime \
  && echo "Europe/Berlin" > /etc/timezone

ENV TZ=Europe/Berlin

WORKDIR /app

COPY package*.json ./


RUN npm install --omit=dev


COPY src ./src


EXPOSE 4000


CMD ["npm", "run", "start"]
